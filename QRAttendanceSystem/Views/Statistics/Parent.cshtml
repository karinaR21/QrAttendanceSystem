@using QRAttendanceSystem.Models
@{
    ViewData["Title"] = "Parent Dashboard";
}

<style>

    /* ===============================
       LAYOUT FIX
    ================================= */

    .btn-soft {
        background: rgba(255,255,255,0.08);
        color: #fff;
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 14px;
        padding: 12px 18px;
        transition: all 0.25s ease;
        font-weight: 600;
        visibility: visible; /* Ensure the button is always visible */
    }

    .stats-card {
        border-radius: 24px;
        padding: 30px 24px;
        text-align: center;
        height: 100%;
        backdrop-filter: blur(10px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.16);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .stats-card span {
        font-size: 1.2rem;
        font-weight: 700;
        color: rgba(255, 255, 255, 0.8);
    }

    .stats-card h1 {
        font-size: 3rem;
        font-weight: 800;
        color: #fff;
    }

    .equal-card {
        height: 420px;
        display: flex;
        flex-direction: column;
    }

    .scroll-content {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        padding-right: 10px;
    }

    .scroll-content::-webkit-scrollbar {
        width: 6px;
    }

    .scroll-content::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,0.25);
        border-radius: 10px;
    }

    .scroll-content::-webkit-scrollbar-thumb:hover {
        background: rgba(255,255,255,0.45);
    }

    .item-row {
        padding: 14px 0;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .item-row:last-child {
        border-bottom: none;
    }

    .icon-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: rgba(255,255,255,0.1);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Improved glass look */
    .glass-card {
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.15);
        backdrop-filter: blur(18px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.35);
        border-radius: 20px;
    }

    /* Risk card styling */
    .risk-card {
        border-left: 6px solid;
        padding: 20px;
    }

</style>

<div class="app-dark-gradient">
    <div class="app-container">

        <!-- HEADER -->
        <div class="text-white mb-4">
            <h1 class="fw-semibold mb-2">Parent Dashboard</h1>
            <span class="email-pill">
                <i class="bi bi-person-heart me-2"></i>
                @ViewBag.ChildName
            </span>

            <!-- FILTER BUTTON -->
            <div class="mt-3">
                <button class="btn btn-soft"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#filters">
                    <i class="bi bi-funnel me-2"></i>
                    Filters
                </button>
            </div>
        </div>

        <!-- FILTER PANEL -->
        <div class="collapse mb-5 @(ViewBag.From != null || ViewBag.To != null || ViewBag.SelectedCourse != null ? "show" : "")"
             id="filters">
            <div class="glass glass-card p-4">

                <form method="get">
                    <div class="row g-3 align-items-end">

                        <div class="col-md-3">
                            <label class="text-white-50 small">From</label>
                            <input type="date" name="from"
                                   value="@ViewBag.From"
                                   class="form-control" />
                        </div>

                        <div class="col-md-3">
                            <label class="text-white-50 small">To</label>
                            <input type="date" name="to"
                                   value="@ViewBag.To"
                                   class="form-control" />
                        </div>

                        <div class="col-md-4">
                            <label class="text-white-50 small">Course</label>
                            <select name="courseId" class="form-select">
                                <option value="">All Classes</option>
                                @foreach (Course c in ViewBag.Courses)
                                {
                                    <option value="@c.Id"
                                            selected="@(ViewBag.SelectedCourse != null && (int)ViewBag.SelectedCourse == c.Id)">
                                        @c.Name
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-2">
                            <div class="d-grid gap-2">
                                <button class="btn btn-soft w-100" type="submit">
                                    Apply
                                </button>
                                <a href="/Statistics/Parent" class="btn btn-outline-light w-100">
                                    Clear
                                </a>
                            </div>
                        </div>

                    </div>
                </form>

            </div>
        </div>

        <!-- RISK CARD -->
        @if ((bool)ViewBag.HasResults)
        {
            var riskLevel = ViewBag.RiskLevel ?? "Good";
            var riskColor = riskLevel == "High" ? "danger"
            : riskLevel == "Warning" ? "warning"
            : "success";

            var riskIcon = riskLevel == "High" ? "bi-exclamation-triangle-fill"
            : riskLevel == "Warning" ? "bi-exclamation-circle-fill"
            : "bi-check-circle-fill";

            <div class="glass glass-card risk-card border-@riskColor mb-4">

                <div class="d-flex align-items-center gap-3">
                    <i class="bi @riskIcon fs-2 text-@riskColor"></i>
                    <div>
                        <h5 class="mb-1">
                            Attendance Risk:
                            <span class="text-@riskColor fw-semibold">
                                @ViewBag.RiskLevel
                            </span>
                        </h5>

                        <div class="text-white-50">
                            @ViewBag.RiskMessage
                        </div>

                        <div class="mt-2 small">
                            Current Attendance Rate:
                            <strong>@ViewBag.AttendancePercentage%</strong>
                        </div>
                    </div>
                </div>

            </div>
        }

        @if (!(bool)ViewBag.HasResults)
        {
            <div class="glass glass-card text-center p-5 mt-4">
                <h4>No attendance records were found</h4>
            </div>
        }
        else
        {

            <!-- STATS -->
            <div class="row g-4 mb-5">
                <div class="col-md-4">
                    <div class="stats-card glass highlight">
                        <span>Total Records</span>
                        <h1>@ViewBag.TotalAttendances</h1>
                    </div>
                </div>

                @foreach (var item in ViewBag.ByStatus)
                {
                    <div class="col-md-4">
                        <div class="stats-card glass">
                            <span>@item.Status Days</span>
                            <h1>@item.Count</h1>
                        </div>
                    </div>
                }
            </div>

            <!-- CONTENT -->
            <div class="row g-4">

                <!-- BY COURSE -->
                <div class="col-lg-6">
                    <div class="glass glass-card equal-card">

                        <h5 class="fw-semibold mb-3">
                            <i class="bi bi-journal-text me-2"></i>
                            Attendance by Course
                        </h5>

                        <div class="scroll-content">

                            @foreach (var item in ViewBag.ByCourse)
                            {
                                <div class="item-row d-flex justify-content-between align-items-center">

                                    <div class="d-flex align-items-center gap-3">

                                        <!-- Icon Circle -->
                                        <div class="icon-circle bg-primary-gradient d-flex align-items-center justify-content-center"
                                             style="width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,0.1);">
                                            <i class="bi bi-book"></i>
                                        </div>

                                        <!-- Course Info -->
                                        <div>
                                            <div class="fw-semibold">
                                                @item.Course
                                            </div>

                                            <div class="small opacity-75">
                                                Total attendances
                                            </div>
                                        </div>

                                    </div>

                                    <!-- Count Badge -->
                                    <span class="badge bg-light text-dark px-3 py-2">
                                        @item.Count
                                    </span>

                                </div>
                            }

                        </div>
                    </div>
                </div>
                <!-- RECENT -->
                <div class="col-lg-6">
                    <div class="glass glass-card equal-card">

                        <h5 class="fw-semibold mb-3">
                            <i class="bi bi-clock-history me-2"></i>
                            Recent Attendance
                        </h5>

                        <div class="scroll-content">

                            @foreach (var item in ViewBag.Recent)
                            {
                                var badgeColor =
                                item.Status == "Present" ? "success" :
                                item.Status == "Late" ? "warning" :
                                "danger";

                                <div class="item-row d-flex justify-content-between align-items-center">
                                    <div>
                                        <div>@item.Course</div>
                                        <div class="small opacity-75">
                                            @item.TimeRecorded
                                        </div>
                                    </div>

                                    <span class="badge bg-@badgeColor px-3 py-2">
                                        @item.Status
                                    </span>
                                </div>
                            }

                        </div>
                    </div>
                </div>

            </div>

        }

    </div>
</div>