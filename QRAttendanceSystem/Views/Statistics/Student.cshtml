@{
    ViewData["Title"] = "My Attendance";
}

<h3 class="mb-4">My Attendance Statistics</h3>

<div class="row g-4 mb-4">

    <div class="col-md-6">
        <div class="card p-4 shadow">
            <h5>Total Attendances</h5>
            <h2>@ViewBag.TotalAttendances</h2>
        </div>
    </div>

</div>

<h4>Attendance by Course</h4>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Course</th>
            <th>Attendances</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in ViewBag.ByCourse)
        {
            <tr>
                <td>@item.Course</td>
                <td>@item.Count</td>
            </tr>
        }
    </tbody>
</table>

<h4 class="mt-4">Recent Attendance</h4>
<ul class="list-group">
    @foreach (var item in ViewBag.Recent)
    {
        <li class="list-group-item">
            <strong>@item.Title</strong><br />
            <small class="text-muted">@item.TimeRecorded</small>
        </li>
    }
</ul>
