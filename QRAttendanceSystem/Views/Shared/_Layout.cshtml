@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Localization
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QR Attendance System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />

    <style>
        body {
            background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
            min-height: 100vh;
            margin: 0;
        }

        .nav-icon-disabled {
            pointer-events: none;
            cursor: default;
            opacity: 0.7;
        }
    </style>
</head>
<body>
    @{
        var role = Context.Session.GetString("Role");
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

        var isAdminDashboard = role == "Admin" && currentController == "Admin" && currentAction == "Index";

        var isDashboardPage =
        (role == "Student" && currentController == "Home" && (currentAction == "_StudentHome" || currentAction == "StudentHome")) ||
        (role == "Student" && currentController == "Statistics" && currentAction == "Student") ||
        (role == "Teacher" && currentController == "Home" && (currentAction == "_TeacherHome" || currentAction == "TeacherHome")) ||
        (role == "Teacher" && currentController == "Statistics" && currentAction == "Index") ||
        (role == "Parent" && currentController == "Home" && (currentAction == "_ParentHome" || currentAction == "ParentHome")) ||
        (role == "Parent" && currentController == "Statistics" && currentAction == "Parent") ||
        (role == "Admin" && currentController == "Admin" && currentAction == "Index");
    }

    <nav class="navbar navbar-expand-lg navbar-dark app-navbar">
        <a class="navbar-brand fw-bold fs-4"
           asp-controller="Home"
           asp-action="Index">
            <i class="bi bi-qr-code-scan me-2"></i>
            QR Attendance System
        </a>

        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#nav"
                aria-controls="nav"
                aria-expanded="false"
                aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav ms-auto align-items-center gap-2 nav-actions">

                <li class="nav-item">
                    @if (isAdminDashboard)
                    {
                        <span class="nav-icon nav-icon-disabled" title="Home">
                            <i class="bi bi-house"></i>
                        </span>
                    }
                    else if (role == "Admin")
                    {
                        <a class="nav-icon"
                           asp-controller="Admin"
                           asp-action="Index"
                           title="Home">
                            <i class="bi bi-house"></i>
                        </a>
                    }
                    else
                    {
                        <a class="nav-icon"
                           asp-controller="Home"
                           asp-action="Index"
                           title="Home">
                            <i class="bi bi-house"></i>
                        </a>
                    }
                </li>

                @if (!string.IsNullOrEmpty(role))
                {
                    @if (role == "Teacher")
                    {
                        <li class="nav-item">
                            <a class="nav-btn"
                               asp-controller="Sessions"
                               asp-action="Create">
                                <i class="bi bi-plus-circle"></i>
                                Generate
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-btn"
                               asp-controller="Statistics"
                               asp-action="Index">
                                <i class="bi bi-bar-chart"></i>
                                Statistics
                            </a>
                        </li>
                    }

                    @if (role == "Student")
                    {
                        <li class="nav-item">
                            <a class="nav-btn"
                               asp-controller="Attendance"
                               asp-action="Scan">
                                <i class="bi bi-camera"></i>
                                Scan
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-btn"
                               asp-controller="Statistics"
                               asp-action="Student">
                                <i class="bi bi-bar-chart"></i>
                                My Stats
                            </a>
                        </li>
                    }

                    @if (role == "Parent")
                    {
                        <li class="nav-item">
                            <a class="nav-btn"
                               asp-controller="Statistics"
                               asp-action="Parent">
                                <i class="bi bi-bar-chart"></i>
                                Child Stats
                            </a>
                        </li>
                    }

                    @if (role == "Admin")
                    {
                        <li class="nav-item">
                            <a class="nav-btn"
                               asp-controller="Admin"
                               asp-action="Index">
                                <i class="bi bi-speedometer2"></i>
                                Admin
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-btn"
                               asp-controller="Admin"
                               asp-action="Users">
                                <i class="bi bi-people"></i>
                                Users
                            </a>
                        </li>
                    }

                    <li class="nav-item">
                        <span class="role-pill">
                            @role
                        </span>
                    </li>

                    <li class="nav-item">
                        <a class="logout-btn"
                           asp-controller="Auth"
                           asp-action="Logout"
                           title="Logout">
                            <i class="bi bi-box-arrow-right"></i>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </nav>

    @if (string.IsNullOrEmpty(role))
    {
        <main class="mt-5">
            @RenderBody()
        </main>
    }
    else if (isDashboardPage)
    {
        <main class="dashboard-main">
            @RenderBody()
        </main>
    }
    else
    {
        <main class="container-fluid mt-4 px-4">
            <div class="glass p-4 shadow-lg text-white">
                @RenderBody()
            </div>
        </main>
    }

    <footer>
        <div class="site-footer">
            © 2026 QR Attendance System
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>