@model List<QRAttendanceSystem.Models.Session>

<h3 class="mb-4 text-center">
    <i class="bi bi-list-check"></i> Sessions
</h3>

<table class="table table-dark table-hover align-middle">
    <thead>
        <tr>
            <th>Course</th>
            <th>Grade</th>
            <th>Section</th>
            <th>Date</th>
            <th class="text-center">QR</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Course?.Name</td>
                <td>@s.Grade</td>
                <td>@s.Section</td>
                <td>@s.Date.ToString("dd.MM.yyyy HH:mm")</td>
                <td class="text-center">
                    <a asp-controller="Attendance"
                       asp-action="ShowQr"
                       asp-route-sessionId="@s.Id"
                       class="btn btn-outline-light btn-sm">
                        <i class="bi bi-qr-code"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="text-center mt-4">
    <a class="btn btn-success"
       asp-controller="Sessions"
       asp-action="Create">
        <i class="bi bi-plus-circle"></i> New Session
    </a>
</div>
