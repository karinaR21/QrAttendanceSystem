@model QRAttendanceSystem.Models.QrToken
@{
    ViewData["Title"] = "Attendance QR";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>

    body {
        background: linear-gradient(135deg, #0f172a, #1e293b);
        color: white;
        margin: 0;
    }

    .page-wrapper {
        min-height: calc(100vh - 60px);
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 40px 20px;
    }

    /* ===============================
           QR CARD
        =============================== */
    .glass-card {
        background: rgba(255,255,255,0.06);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 28px;
        padding: 40px;
        width: 100%;
        max-width: 420px;
        text-align: center;
        box-shadow: 0 25px 60px rgba(0,0,0,0.5);
        margin-bottom: 50px;
    }
    .glass-card {
        display: flex;
        flex-direction: column;
        align-items: center; 
    }

    .live-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(25,135,84,.15);
        color: #20c997;
        padding: 6px 16px;
        border-radius: 50px;
        font-weight: 600;
        font-size: 14px;
        margin-bottom: 25px;
    }

    .pulse-dot {
        width: 10px;
        height: 10px;
        background: #20c997;
        border-radius: 50%;
        animation: pulse 1.2s infinite;
    }

    @@keyframes pulse {
        0% {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(1.4);
            opacity: 0.5;
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    #qrCode {
        max-width: 280px;
        border-radius: 20px;
    }

    .glow-qr {
        animation: qrGlow 1.8s ease-in-out infinite alternate;
    }

    @@keyframes qrGlow {
        from {
            box-shadow: 0 0 15px rgba(25,135,84,.4);
        }

        to {
            box-shadow: 0 0 45px rgba(25,135,84,1);
        }
    }

    .qr-placeholder {
        width: 280px;
        height: 280px;
        margin: 0 auto; 
        border-radius: 22px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: #adb5bd;
    }

    .hourglass-icon {
        font-size: 70px;
        animation: spinHourglass 2.5s linear infinite;
    }

    @@keyframes spinHourglass {
        0% {
            transform: rotate(0deg);
        }

        50% {
            transform: rotate(180deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    .hidden {
        display: none !important;
    }

    #timer {
        margin-top: 20px;
        font-size: 18px;
        font-weight: 600;
    }

    /* ===============================
           LIVE LIST
        =============================== */

    .live-section {
        width: 100%;
        max-width: 500px;
        text-align: center;
    }

        .live-section h5 {
            margin-bottom: 25px;
            color: #e9ecef; 
        }

    .live-list .list-group-item {
        background: rgba(255, 255, 255, 0.12); 
        border: 1px solid rgba(255, 255, 255, 0.2); 
        color: #f8f9fa;
        border-radius: 14px;
        margin-bottom: 12px;
        transition: all 0.2s ease;
        backdrop-filter: blur(10px);
    }

        .live-list .list-group-item:hover {
            background: rgba(255, 255, 255, 0.18);
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
        }
    /* ===============================
       LIVE LIST SCROLL FIX
    ================================= */

    .live-list {
        max-height: 300px; 
        overflow-y: auto; 
        padding-right: 6px;
    }

        .live-list::-webkit-scrollbar {
            width: 6px;
        }

        .live-list::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.35);
            border-radius: 10px;
        }
</style>

<div class="page-wrapper">

    <div class="glass-card">

        <h2 class="mb-3">
            <i class="bi bi-qr-code"></i> Attendance QR
        </h2>

     

        <img id="qrCode"
             src="@Url.Action("Generate", "Qr", new { sessionId = Model.SessionId })"
             class="img-fluid hidden" />

        <div id="qrPlaceholder" class="qr-placeholder">
            <i class="bi bi-hourglass-split hourglass-icon"></i>
            <p class="mt-3 fw-semibold text-center px-3">
                QR will unlock when the session starts
            </p>
        </div>

        <p id="qrStatus" class="fw-semibold mt-3"></p>
        <p id="timer"></p>

    </div>

    <!-- LIVE ATTENDANCE -->
    <div class="live-section">

        <h5>
            <i class="bi bi-people-fill"></i> Live Attendance
        </h5>

        <ul id="liveList" class="list-group live-list">
            <li class="list-group-item text-muted text-center">
                Waiting for scans...
            </li>
        </ul>

    </div>

</div>

<script>

    const startTime = new Date("@Model.Session.StartTime.ToString("o")").getTime();
    const endTime = new Date("@Model.Session.EndTime.ToString("o")").getTime();
    const sessionId = @Model.SessionId;

    function updateTimer() {

        const now = new Date().getTime();
        const qr = document.getElementById("qrCode");
        const placeholder = document.getElementById("qrPlaceholder");

        if (now < startTime) {
            qr.classList.add("hidden");
            qr.classList.remove("glow-qr");
            placeholder.classList.remove("hidden");

            const diff = startTime - now;
            const minutes = Math.floor(diff / 60000);
            const seconds = Math.floor((diff % 60000) / 1000);

            document.getElementById("timer").innerText =
                `Session starts in: ${minutes}:${seconds.toString().padStart(2, '0')}`;

            document.getElementById("timer").style.color = "#ffc107";
            return;
        }

        if (now >= endTime) {
            qr.classList.add("hidden");
            qr.classList.remove("glow-qr");
            placeholder.classList.remove("hidden");
            placeholder.querySelector("p").innerText = "QR is closed.";

            document.getElementById("timer").innerText = "Session ended";
            document.getElementById("timer").style.color = "#dc3545";
            return;
        }

        placeholder.classList.add("hidden");
        qr.classList.remove("hidden");
        qr.classList.add("glow-qr");

        document.getElementById("qrStatus").innerText =
            "Scan now to register attendance.";

        const diff = endTime - now;
        const minutes = Math.floor(diff / 60000);
        const seconds = Math.floor((diff % 60000) / 1000);

        document.getElementById("timer").innerText =
            `Time left: ${minutes}:${seconds.toString().padStart(2, '0')}`;

        document.getElementById("timer").style.color = "#20c997";
    }

    async function loadLiveList() {

        const res = await fetch(`/Attendance/LiveList?sessionId=${sessionId}`);
        const data = await res.json();

        const ul = document.getElementById("liveList");
        ul.innerHTML = "";

        if (data.length === 0) {
            ul.innerHTML = `
                <li class="list-group-item text-muted text-center">
                    Waiting for scans...
                </li>`;
            return;
        }

        data.forEach(item => {

            const color =
                item.status === "Present" ? "success" :
                item.status === "Late" ? "warning" : "secondary";

            ul.innerHTML += `
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <strong>${item.student}</strong><br/>
                        <small class="text-muted">${item.time}</small>
                    </div>
                    <span class="badge bg-${color}">
                        ${item.status}
                    </span>
                </li>`;
        });
    }

    function refreshQr() {
        const now = new Date().getTime();
        if (now >= startTime && now < endTime) {
            document.getElementById("qrCode").src =
                `/Qr/Generate?sessionId=${sessionId}&t=` + new Date().getTime();
        }
    }

    setInterval(updateTimer, 1000);
    setInterval(refreshQr, 3000);
    setInterval(loadLiveList, 5000);

    updateTimer();
    loadLiveList();

</script>