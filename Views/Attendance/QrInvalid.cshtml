@{
    ViewData["Title"] = "QR Invalid";
}

<div class="text-center mt-5">
    <h3 class="text-danger mb-3">
        QR code is no longer valid
    </h3>

    <p class="text-muted">
        Please generate a new session.
    </p>

    <a asp-controller="Sessions"
       asp-action="Create"
       class="btn btn-primary mt-3">
        Create New Session
    </a>
</div>
