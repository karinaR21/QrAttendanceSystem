@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Localization
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QR Attendance System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />


    <style>
        body {
            background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
            min-height: 100vh;
        }

        .glass {
            background: rgba(255,255,255,0.08);
            backdrop-filter: blur(12px);
            border-radius: 16px;
        }
    </style>
</head>
<body>

    @{
        var role = Context.Session.GetString("Role");
    }

    <nav class="navbar navbar-expand-lg navbar-dark glass shadow-lg mt-3 mx-3 px-4">

            <a class="navbar-brand fw-bold fs-4"
           asp-controller="Home"
           asp-action="Index">
                <i class="bi bi-qr-code-scan me-2"></i>
                QR Attendance System
        </a>

        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#nav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav ms-auto align-items-center gap-2 nav-actions">

                

                    <li class="nav-item">
                        <a class="nav-icon"
                           asp-controller="Home"
                           asp-action="Index"
                           title="Home">
                            <i class="bi bi-house"></i>
                        </a>
                    </li>

                @if (!string.IsNullOrEmpty(role))
                {
                    @if (role == "Teacher")
                    {
                        <li class="nav-item">
                            <a class="nav-btn"
                               asp-controller="Sessions"
                               asp-action="Create">
                                <i class="bi bi-plus-circle"></i>
                                Generate
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-btn"
                               asp-controller="Statistics"
                               asp-action="Index">
                                <i class="bi bi-bar-chart"></i>
                                Statistics
                            </a>
                        </li>
                    }

                    @if (role == "Student")
                    {
                        <li class="nav-item">
                            <a class="nav-btn"
                               asp-controller="Attendance"
                               asp-action="Scan">
                        <i class="bi bi-camera"></i>
                                Scan
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-btn"
                               asp-controller="Statistics"
                               asp-action="Student">
                                <i class="bi bi-bar-chart"></i>
                                My Stats
                            </a>
                        </li>
                    }

                    @if (role == "Parent")
                    {
                        <li class="nav-item">
                            <a class="nav-btn"
                               asp-controller="Statistics"
                               asp-action="Parent">
                                <i class="bi bi-bar-chart"></i>
                                Child Stats
                            </a>
                        </li>
                    }

                    <!-- ROLE -->
                    <li class="nav-item">
                        <span class="role-pill">
                            @role
                        </span>
                    </li>

                    <!-- LOGOUT -->
                    <li class="nav-item">
                        <a class="logout-btn"
                           asp-controller="Auth"
                           asp-action="Logout"
                           title="Logout">
                            <i class="bi bi-box-arrow-right"></i>
                        </a>
                    </li>
                }

            </ul>

            <!-- LANGUAGE SELECTOR -->
            <div class="collapse navbar-collapse" id="languageSelector">
                <ul class="navbar-nav ms-auto align-items-center gap-2">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="languageDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Language
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="languageDropdown">
                            <li>
                                <form method="post" asp-controller="Localization" asp-action="SetLanguage" class="d-inline">
                                    <input type="hidden" name="culture" value="en" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                    <button type="submit" class="dropdown-item">English</button>
                                </form>
                            </li>
                            <li>
                                <form method="post" asp-controller="Localization" asp-action="SetLanguage" class="d-inline">
                                    <input type="hidden" name="culture" value="bg" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                    <button type="submit" class="dropdown-item">Български</button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>



    <!-- ================= MAIN CONTENT ================= -->
    <main class="@(string.IsNullOrEmpty(role) ? "mt-5" : "container mt-5")">
        <div class="@(string.IsNullOrEmpty(role) ? "" : "glass p-4 shadow-lg text-white")">
            @RenderBody()
        </div>
    </main>

    <footer class="text-center text-white-50 mt-5 pb-3">
        <div class="site-footer">
            © 2026 QR Attendance System
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
