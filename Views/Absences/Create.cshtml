@{
    ViewData["Title"] = "Submit Absence";
    var children = ViewBag.Children as List<User>;
}

<div class="absence-page d-flex justify-content-center align-items-center">

    <div class="absence-card slide-in">

        <!-- HEADER -->
        <div class="text-center mb-4">

            <div class="icon-circle mb-3">
                <i class="bi bi-envelope-paper"></i>
            </div>

            <h3 class="absence-title mb-1">
                Submit Absence
            </h3>

            <p class="absence-subtitle">
                Notify the school about your child's absence
            </p>

        </div>

        <form asp-action="Create" method="post" enctype="multipart/form-data">

            <!-- CHILD -->
            <div class="form-group-modern">

                <input type="hidden" name="UserId" value="@children.First().Id" />

                <div class="selected-child mb-3">
                    <label>Child</label>
                    <div class="child-pill">
                        <i class="bi bi-person-fill"></i>
                        @children.First().FullName
                    </div>
                </div>

            </div>

            <!-- DATE -->
            <div class="form-group-modern">
                <label>Absence Date</label>

                <input type="date"
                       name="AbsenceDate"
                       class="form-control"
                       required />
            </div>

            <!-- REASON -->
            <div class="form-group-modern">
                <label>Reason</label>

                <textarea name="Reason"
                          rows="4"
                          class="form-control"
                          placeholder="Describe the reason..."
                          required></textarea>
            </div>

            <!-- FILE -->
            <div class="form-group-modern">
                <label>Attach Document (optional)</label>

                <input type="file"
                       name="document"
                       class="form-control" />
            </div>

            <button type="submit" class="btn btn-soft w-100 mt-3">
                <i class="bi bi-send-check me-2"></i>
                Submit Absence
            </button>

        </form>

    </div>
</div>
