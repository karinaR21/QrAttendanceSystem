@using QRAttendanceSystem.Models
@{
    ViewData["Title"] = "Parent Dashboard";
}

<div class="app-dark-gradient">
    <div class="app-container">

        <!-- HEADER -->
        <div class="text-white mb-4">
            <h1 class="fw-semibold mb-2">Parent Dashboard</h1>
            <span class="email-pill">
                <i class="bi bi-person-heart me-2"></i>
                @ViewBag.ChildName
            </span>
        </div>

        <!-- FILTERS -->
        <div class="mb-4">
            <button class="btn btn-soft"
                    data-bs-toggle="collapse"
                    data-bs-target="#filters">
                <i class="bi bi-funnel me-2"></i>
                Filters
            </button>
        </div>

        <div class="collapse mb-4 @(ViewBag.From != null || ViewBag.To != null || ViewBag.SelectedCourse != null ? "show" : "")"
             id="filters">

            <div class="glass glass-card p-4">
                <form method="get">
                    <div class="row g-3 align-items-end">

                        <div class="col-md-3">
                            <label class="text-white-50 small">From</label>
                            <input type="date"
                                   name="from"
                                   value="@ViewBag.From"
                                   class="form-control" />
                        </div>

                        <div class="col-md-3">
                            <label class="text-white-50 small">To</label>
                            <input type="date"
                                   name="to"
                                   value="@ViewBag.To"
                                   class="form-control" />
                        </div>

                        <div class="col-md-4">
                            <label class="text-white-50 small">Course</label>
                            <select name="courseId" class="form-select">
                                <option value="">All Classes</option>

                                @foreach (Course c in ViewBag.Courses)
                                {
                                    if (ViewBag.SelectedCourse != null && (int)ViewBag.SelectedCourse == c.Id)
                                    {
                                        <option value="@c.Id" selected>@c.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-2">
                            <button class="btn btn-soft w-100">Apply</button>
                        </div>

                    </div>
                </form>
            </div>
        </div>

        @if (!(bool)ViewBag.HasResults)
        {
            <div class="glass glass-card text-center p-5 mt-4">
                <i class="bi bi-search display-4 opacity-25 mb-3"></i>
                <h4>No attendance records were found</h4>
                <p class="text-white-50">Try adjusting the filters.</p>
            </div>
        }
        else
        {
            var riskLevel = ViewBag.RiskLevel ?? "Good";

            var riskColor = riskLevel == "High"
            ? "danger"
            : riskLevel == "Warning"
            ? "warning"
            : "success";

            var riskIcon = riskLevel == "High"
            ? "bi-exclamation-triangle-fill"
            : riskLevel == "Warning"
            ? "bi-exclamation-circle-fill"
            : "bi-check-circle-fill";

            <!-- RISK CARD -->
            <div class="glass glass-card mb-4 border-start border-4 border-@riskColor">
                <div class="d-flex align-items-center gap-3">
                    <i class="bi @riskIcon fs-2 text-@riskColor"></i>
                    <div>
                        <h5 class="mb-1">
                            Attendance Risk:
                            <span class="text-@riskColor fw-semibold">
                                @ViewBag.RiskLevel
                            </span>
                        </h5>
                        <div class="text-white-50">
                            @ViewBag.RiskMessage
                        </div>
                        <div class="mt-2 small">
                            Current Attendance Rate:
                            <strong>@ViewBag.AttendancePercentage%</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- STATS -->
            <div class="row g-4 mb-5">
                <div class="col-md-4">
                    <div class="stats-card glass highlight">
                        <span>Total Records</span>
                        <h1>@ViewBag.TotalAttendances</h1>
                    </div>
                </div>

                @foreach (var item in ViewBag.ByStatus)
                {
                    var statHighlight = item.Status == "Present" ? "highlight" : "";

                    <div class="col-md-4">
                        <div class="stats-card glass @statHighlight">
                            <span>@item.Status Days</span>
                            <h1>@item.Count</h1>
                        </div>
                    </div>
                }
            </div>

            <!-- COURSE + RECENT -->
            <div class="row g-4">

                <div class="col-lg-6">
                    <div class="glass glass-card h-100">

                        <h5 class="mb-4 fw-semibold">
                            <i class="bi bi-journal-text me-2"></i>
                            Attendance by Course
                        </h5>

                        @foreach (var item in ViewBag.ByCourse)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-3 p-3 rounded"
                                 style="background: rgba(255,255,255,0.05);">

                                <div class="d-flex align-items-center gap-3">

                                    <div class="icon-circle bg-primary-gradient"
                                         style="width:40px;height:40px;">
                                        <i class="bi bi-book"></i>
                                    </div>

                                    <div>
                                        <div class="fw-semibold">
                                            @item.Course
                                        </div>

                                        <div class="opacity-75 small">
                                            Total attendances
                                        </div>
                                    </div>

                                </div>

                                <span class="badge bg-light text-dark px-3 py-2">
                                    @item.Count
                                </span>

                            </div>
                        }

                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="glass glass-card h-100">

                        <h5 class="mb-4 fw-semibold">
                            <i class="bi bi-clock-history me-2"></i>
                            Recent Attendance
                        </h5>

                        @foreach (var item in ViewBag.Recent)
                        {
                            var badgeColor =
                            item.Status == "Present" ? "success" :
                            item.Status == "Late" ? "warning" :
                            "danger";

                            <div class="d-flex justify-content-between align-items-center mb-3 p-3 rounded"
                                 style="background: rgba(255,255,255,0.05);">

                                <div class="d-flex align-items-center gap-3">

                                    <div class="icon-circle bg-primary-gradient"
                                         style="width:40px;height:40px;">
                                        <i class="bi bi-calendar-check"></i>
                                    </div>

                                    <div>
                                        <div class="fw-semibold">
                                            @item.Course
                                        </div>

                                        <div class="opacity-75 small">
                                            @item.TimeRecorded
                                        </div>
                                    </div>

                                </div>

                                <span class="badge bg-@badgeColor px-3 py-2">
                                    @item.Status
                                </span>

                            </div>
                        }

                    </div>
                </div>
            </div>
        }
    </div>
</div>