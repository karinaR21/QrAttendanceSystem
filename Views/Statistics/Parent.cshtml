@{
    ViewData["Title"] = "Parent Dashboard";
}

<div class="container my-5">

   
    <!-- HEADER -->
    <div class="parent-header mb-5">
        <h1 class="fw-bold mb-1 text-white">Parent Dashboard</h1>

        <div class="d-flex align-items-center gap-2 text-white-50">
            <i class="bi bi-person-heart"></i>
            <span>@ViewBag.ChildName</span>
        </div>
    </div>


    <!-- SUMMARY + STATUS (FIXED) -->
    <div class="row g-4 mb-4">

        <!-- TOTAL RECORDS (BIG LIKE STUDENT) -->
        <div class="col-lg-3 col-md-6">
            <div class="stat-card bg-primary text-white">
                <div class="icon">
                    <i class="bi bi-clipboard-data"></i>
                </div>
                <h2>@ViewBag.TotalAttendances</h2>
                <span>Total Records</span>
            </div>
        </div>

        @foreach (var item in ViewBag.ByStatus)
        {
            var statusText = item.Status.ToString();

            if (statusText == "Present")
            {
                <!-- PRESENT (BIG LIKE STUDENT) -->
                <div class="col-lg-3 col-md-6">
                    <div class="stat-card bg-success-gradient text-white">
                        <div class="icon">
                            <i class="bi bi-check-circle"></i>
                        </div>
                        <h2>@item.Count</h2>
                        <span>Present</span>
                    </div>
                </div>
            }
            else
            {
                var color = statusText == "Late" ? "warning" : "danger";

                <!-- SMALL SECONDARY STATS -->
                <div class="col-lg-3 col-md-6">
                    <div class="card stat-card-sm bg-@color bg-opacity-10">
                        <div class="card-body text-center">
                            <div class="stat-number text-@color">
                                @item.Count
                            </div>
                            <div class="stat-label">
                                @statusText
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>


    <!-- COURSE + RECENT (SIDE BY SIDE) -->
    <div class="row g-4">

        <!-- LEFT: BY COURSE -->
        <div class="col-lg-6">
            <div class="card dashboard-card h-100">
                <div class="card-body">
                    <h5 class="fw-bold mb-4">
                        <i class="bi bi-journal-text me-2 text-primary"></i>
                        Attendance by Course
                    </h5>

                    @foreach (var item in ViewBag.ByCourse)
                    {
                        <div class="course-item-modern">
                            <div class="course-left">
                                <div class="course-icon">
                                    <i class="bi bi-book"></i>
                                </div>
                                <span>@item.Course</span>
                            </div>
                            <span class="course-count">@item.Count</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- RIGHT: RECENT -->
        <div class="col-lg-6">
            <div class="card dashboard-card h-100">
                <div class="card-body">
                    <h5 class="fw-bold mb-4">
                        <i class="bi bi-clock-history me-2 text-primary"></i>
                        Recent Attendance
                    </h5>

                    @foreach (var item in ViewBag.Recent)
                    {
                        var statusText = item.Status.ToString();
                        var color =
                        statusText == "Present" ? "success" :
                        statusText == "Late" ? "warning" : "danger";

                        <div class="activity-item-modern">
                            <div>
                                <div class="activity-course">@item.Course</div>
                                <div class="activity-time">
                                    <i class="bi bi-calendar-event me-1"></i>
                                    @item.TimeRecorded
                                </div>
                            </div>

                            <span class="badge rounded-pill bg-@color px-3 py-2">
                                @statusText
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>
</div>
