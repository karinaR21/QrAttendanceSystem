@{
    ViewData["Title"] = "Parent Dashboard";
}

<div class="app-dark-gradient">

    <div class="app-container">

        <!-- HEADER -->
        <div class="text-white mb-5">
            <h1 class="fw-semibold mb-2">Parent Dashboard</h1>

            <span class="email-pill">
                <i class="bi bi-person-heart me-2"></i>
                @ViewBag.ChildName
            </span>
        </div>

        <!-- STATS -->
        <div class="row g-4 mb-5">

            <div class="col-md-4">
                <div class="stats-card glass highlight">
                    <span>Total Records</span>
                    <h1>@ViewBag.TotalAttendances</h1>
                </div>
            </div>

            @foreach (var item in ViewBag.ByStatus)
            {
                var highlight =
                item.Status.ToString() == "Present"
                ? "highlight"
                : "";

                <div class="col-md-4">
                    <div class="stats-card glass @highlight">
                        <span>@item.Status Days</span>
                        <h1>@item.Count</h1>
                    </div>
                </div>
            }
        </div>

        <!-- COURSE + RECENT -->
        <div class="row g-4">

            <div class="col-lg-6">
                <div class="glass glass-card h-100">
                    <h5 class="mb-4 fw-semibold">
                        <i class="bi bi-journal-text me-2"></i>
                        Attendance by Course
                    </h5>

                    @foreach (var item in ViewBag.ByCourse)
                    {
                        <div class="course-item-modern d-flex justify-content-between align-items-center">
                            <div class="course-left d-flex align-items-center gap-3">
                                <div class="course-icon">
                                    <i class="bi bi-book"></i>
                                </div>
                                <span class="course-name">@item.Course</span>
                            </div>

                            <span class="course-count">@item.Count</span>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-6">
                <div class="glass glass-card h-100">
                    <h5 class="mb-4 fw-semibold">
                        <i class="bi bi-clock-history me-2"></i>
                        Recent Attendance
                    </h5>

                    @foreach (var item in ViewBag.Recent)
                    {
                        var color =
                        item.Status.ToString() == "Present"
                        ? "success"
                        : item.Status.ToString() == "Late"
                        ? "warning"
                        : "danger";

                        <div class="activity-item-modern d-flex justify-content-between align-items-center">
                            <div>
                                <div>@item.Course</div>
                                <div class="opacity-75">
                                    <i class="bi bi-calendar-event me-1"></i>
                                    @item.TimeRecorded
                                </div>
                            </div>

                            <span class="badge rounded-pill bg-@color px-3 py-2">
                                @item.Status
                            </span>
                        </div>
                    }
                </div>
            </div>

        </div>

    </div>
</div>
