@{
    ViewData["Title"] = "My Attendance";
}

<div class="container my-5">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="fw-bold mb-1">My Attendance</h1>
            <div class="d-flex align-items-center gap-2">
                <span class="badge email-badge px-3 py-2">
                    <i class="bi bi-envelope-fill me-2"></i>
                    @ViewBag.Email
                </span>

            </div>
        </div>
    </div>


    <!-- STATS (GRADIENT CARDS) -->
    <div class="row g-4 mb-5">

        <!-- OVERALL -->
        <div class="col-md-3">
            <div class="stat-card bg-primary text-white">
                <div class="icon">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <h2>@ViewBag.TotalAttendances%</h2>
                <span>Overall Rate</span>
            </div>
        </div>

        @foreach (var item in ViewBag.ByStatus)
        {
            var statusText = item.Status.ToString();
            var gradient =
            statusText == "Present" ? "bg-success-gradient" :
            statusText == "Late" ? "bg-warning-gradient" :
                            "bg-danger-gradient";

            var icon =
            statusText == "Present" ? "bi-check-circle" :
            statusText == "Late" ? "bi-clock-history" :
                            "bi-x-circle";

            <div class="col-md-3">
                <div class="stat-card @gradient text-white">
                    <div class="icon">
                        <i class="bi @icon"></i>
                    </div>
                    <h2>@item.Count</h2>
                    <span>@statusText Days</span>
                </div>
            </div>
        }
    </div>

    <div class="row g-5">

        <!-- LEFT: Attendance by Course -->
        <div class="col-lg-6">
            <div class="card course-card h-100 ">
                <div class="card-body">
                    <h5 class="fw-bold mb-4">
                        <i class="bi bi-journal-text me-2 text-primary"></i>
                        Attendance by Course
                    </h5>

                    @foreach (var item in ViewBag.ByCourse)
                    {
                        <div class="course-item-modern">
                            <div class="course-left">
                                <div class="course-icon">
                                    <i class="bi bi-book"></i>
                                </div>
                                <span>@item.Course</span>
                            </div>
                            <span class="course-count">@item.Count</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- RIGHT: Recent Activity -->
        <div class="col-lg-6">
            <div class="card activity-card h-100">
                <div class="card-body">
                    <h5 class="fw-bold mb-4">
                        <i class="bi bi-clock-history me-2 text-primary"></i>
                        Recent Activity
                    </h5>

                    @foreach (var item in ViewBag.Recent)
                    {
                        var statusText = item.Status.ToString();
                        var color =
                        statusText == "Present" ? "success" :
                        statusText == "Late" ? "warning" :
                                "danger";

                        <div class="activity-item-modern">
                            <div>
                                <div class="activity-course">@item.Course</div>
                                <div class="activity-time">
                                    <i class="bi bi-calendar-event me-1"></i>
                                    @item.TimeRecorded
                                </div>
                            </div>

                            <span class="badge rounded-pill bg-@color px-3 py-2">
                                @statusText
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
