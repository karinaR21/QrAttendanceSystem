@using QRAttendanceSystem.Models

<style>

    /* ===============================
       DASHBOARD DESIGN
    ================================= */

    .equal-card {
        height: 420px;
        display: flex;
        flex-direction: column;
    }

    .scroll-content {
        max-height: 300px;
        overflow-y: scroll; 
    }

        /* Scrollbar */
        .scroll-content::-webkit-scrollbar {
            width: 6px;
        }

        .scroll-content::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.25);
            border-radius: 10px;
        }

    /* Glass card */
    .glass-card {
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.12);
        backdrop-filter: blur(18px);
        border-radius: 20px;
    }

    .item-row {
        padding: 14px 0;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }

        .item-row:last-child {
            border-bottom: none;
        }

    /* ===============================
       PALE STAT CARDS
    ================================= */

    .stat-card {
        border-radius: 18px;
        padding: 28px;
        text-align: center;
        transition: 0.3s ease;
    }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 25px rgba(0,0,0,0.25);
        }

    .stat-title {
        font-size: 0.95rem;
        opacity: 0.8;
    }

    .stat-value {
        font-size: 2.4rem;
        font-weight: 700;
        margin-top: 8px;
    }

    /* Pale colors */

    .stat-present {
        background: rgba(34,197,94,0.15);
        border: 1px solid rgba(34,197,94,0.35);
        color: #22c55e;
    }

    .stat-late {
        background: rgba(250,204,21,0.15);
        border: 1px solid rgba(250,204,21,0.35);
        color: #facc15;
    }

    .stat-absent {
        background: rgba(239,68,68,0.15);
        border: 1px solid rgba(239,68,68,0.35);
        color: #ef4444;
    }

</style>

<div class="app-dark-gradient">
    <div class="app-container">

        <!-- HEADER -->
        <div class="text-white mb-4">
            <h1 class="fw-semibold mb-2">My Attendance</h1>
            <span class="email-pill">
                <i class="bi bi-envelope me-2"></i>
                @ViewBag.Email
            </span>
        </div>

        <!-- FILTER BUTTON -->
        <div class="mb-4">
            <button class="btn btn-soft"
                    data-bs-toggle="collapse"
                    data-bs-target="#filters">
                <i class="bi bi-funnel me-2"></i>
                Filters
            </button>
        </div>

        <!-- FILTER PANEL -->
        <div class="collapse mb-4 @(ViewBag.From != null || ViewBag.To != null || ViewBag.SelectedCourse != null ? "show" : "")"
             id="filters">

            <div class="glass glass-card p-4">

                <form method="get">
                    <div class="row g-3 align-items-end">

                        <div class="col-md-3">
                            <label class="text-white-50 small">From</label>
                            <input type="date"
                                   name="from"
                                   value="@ViewBag.From"
                                   class="form-control" />
                        </div>

                        <div class="col-md-3">
                            <label class="text-white-50 small">To</label>
                            <input type="date"
                                   name="to"
                                   value="@ViewBag.To"
                                   class="form-control" />
                        </div>

                        <div class="col-md-4">
                            <label class="text-white-50 small">Course</label>
                            <select name="courseId" class="form-select">
                                <option value="">All Classes</option>

                                @foreach (Course c in ViewBag.Courses)
                                {
                                    if (ViewBag.SelectedCourse != null && (int)ViewBag.SelectedCourse == c.Id)
                                    {
                                        <option value="@c.Id" selected="selected">@c.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-2">
                            <button class="btn btn-soft w-100">Apply</button>
                        </div>

                    </div>
                </form>

            </div>
        </div>

        @if (!(bool)ViewBag.HasResults)
        {
            <div class="glass glass-card text-center p-5 mt-4">
                <h4>No attendance records were found</h4>
                <p class="text-white-50">Try adjusting your filters.</p>
            </div>
        }
        else
        {
            int present = 0;
            int late = 0;
            int absent = 0;

            if (ViewBag.ByStatus != null)
            {
                foreach (var s in ViewBag.ByStatus)
                {
                    if (s.Status == "Present") present = s.Count;
                    else if (s.Status == "Late") late = s.Count;
                    else if (s.Status == "Absent") absent = s.Count;
                }
            }

            <!-- PALE STAT CARDS -->
            <div class="row g-4 mb-5">

                <div class="col-md-4">
                    <div class="stat-card stat-present">
                        <div class="stat-title">Present Days</div>
                        <div class="stat-value">@present</div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="stat-card stat-late">
                        <div class="stat-title">Late Days</div>
                        <div class="stat-value">@late</div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="stat-card stat-absent">
                        <div class="stat-title">Absent Days</div>
                        <div class="stat-value">@absent</div>
                    </div>
                </div>

            </div>

            <!-- MAIN CONTENT -->
            <div class="row g-4">

             
                <!-- BY COURSE -->
                <div class="col-lg-6">
                    <div class="glass glass-card equal-card">

                        <h5 class="fw-semibold mb-3">
                            <i class="bi bi-journal-text me-2"></i>
                            Attendance by Course
                        </h5>

                        <div class="scroll-content">

                            @foreach (var item in ViewBag.ByCourse)
                            {
                                <div class="item-row d-flex justify-content-between align-items-center">

                                    <div class="d-flex align-items-center gap-3">

                                        <!-- Icon Circle -->
                                        <div class="icon-circle bg-primary-gradient d-flex align-items-center justify-content-center"
                                             style="width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,0.1);">
                                            <i class="bi bi-book"></i>
                                        </div>

                                        <!-- Course Info -->
                                        <div>
                                            <div class="fw-semibold">
                                                @item.Course
                                            </div>

                                            <div class="small opacity-75">
                                                Total attendances
                                            </div>
                                        </div>

                                    </div>

                                    <!-- Count Badge -->
                                    <span class="badge bg-light text-dark px-3 py-2">
                                        @item.Count
                                    </span>

                                </div>
                            }

                        </div>
                    </div>
                </div>

                <!-- RECENT -->
                <div class="col-lg-6">
                    <div class="glass glass-card equal-card">

                        <h5 class="fw-semibold mb-3">
                            <i class="bi bi-clock-history me-2"></i>
                            Recent Activity
                        </h5>

                        <div class="scroll-content">

                            @foreach (var item in ViewBag.Recent)
                            {
                                string color =
                                item.Status == "Present" ? "success" :
                                item.Status == "Late" ? "warning" :
                                "danger";

                                <div class="item-row d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-semibold">@item.Course</div>
                                        <div class="small opacity-75">@item.TimeRecorded</div>
                                    </div>

                                    <span class="badge bg-@color px-3 py-2">
                                        @item.Status
                                    </span>
                                </div>
                            }

                        </div>
                    </div>
                </div>

            </div>

        }

    </div>
</div>