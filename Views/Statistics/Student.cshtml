@using QRAttendanceSystem.Models

<div class="app-dark-gradient">

    <div class="app-container">

        <!-- HEADER -->
        <div class="text-white mb-4">
            <h1 class="fw-semibold mb-2">My Attendance</h1>

            <span class="email-pill">
                <i class="bi bi-envelope me-2"></i>
                @ViewBag.Email
            </span>
        </div>


        <!-- FILTER BUTTON -->
        <div class="mb-4">
            <button class="btn btn-soft"
                    data-bs-toggle="collapse"
                    data-bs-target="#filters">

                <i class="bi bi-funnel me-2"></i>
                Filters
            </button>
        </div>



        <!-- FILTER PANEL -->
        <div class="collapse mb-4
        @(ViewBag.From != null
                     || ViewBag.To != null
                     || ViewBag.SelectedCourse != null
                     ? "show" : "")"
             id="filters">

            <div class="glass glass-card p-4">

                <form method="get">

                    <div class="row g-3 align-items-end">

                        <!-- FROM -->
                        <div class="col-md-3">
                            <label class="text-white-50 small">From</label>

                            <input type="date"
                                   name="from"
                                   value="@ViewBag.From"
                                   class="form-control" />
                        </div>


                        <!-- TO -->
                        <div class="col-md-3">
                            <label class="text-white-50 small">To</label>

                            <input type="date"
                                   name="to"
                                   value="@ViewBag.To"
                                   class="form-control" />
                        </div>


                        <!-- COURSE -->
                        <div class="col-md-4">
                            <label class="text-white-50 small">Course</label>

                            <select name="courseId" class="form-select">

                                <option value="">All Classes</option>

                                @foreach (Course c in ViewBag.Courses)
                                {
                                    if (ViewBag.SelectedCourse != null &&
                                    (int)ViewBag.SelectedCourse == c.Id)
                                    {
                                        <option selected value="@c.Id">
                                            @c.Name
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@c.Id">
                                            @c.Name
                                        </option>
                                    }
                                }

                            </select>
                        </div>


                        <!-- APPLY -->
                        <div class="col-md-2">
                            <button class="btn btn-soft w-100">
                                Apply
                            </button>
                        </div>

                    </div>

                </form>

            </div>
        </div>



        <!-- ACTIVE FILTERS -->
        @if (ViewBag.From != null
                || ViewBag.To != null
                || ViewBag.SelectedCourse != null)
        {
            var selectedCourse = ((List<Course>)ViewBag.Courses)
            .FirstOrDefault(c => c.Id == ViewBag.SelectedCourse);

            <div class="glass glass-card p-3 mb-4">

                <span class="text-white-50 me-2">
                    Showing results for:
                </span>

                @if (ViewBag.From != null)
                {
                    <span class="badge bg-light text-dark me-2">
                        From @ViewBag.From
                    </span>
                }

                @if (ViewBag.To != null)
                {
                    <span class="badge bg-light text-dark me-2">
                        To @ViewBag.To
                    </span>
                }

                @if (selectedCourse != null)
                {
                    <span class="badge bg-light text-dark me-2">
                        @selectedCourse.Name
                    </span>
                }

                <a href="/Statistics/Student"
                   class="btn btn-sm btn-soft ms-2">
                    Clear
                </a>

            </div>
        }



        <!-- NO RESULTS -->
        @if (!(bool)ViewBag.HasResults)
        {
            <div class="glass glass-card text-center p-5 mt-4">

                <i class="bi bi-search display-4 opacity-25 mb-3"></i>

                <h4>No attendance records were found</h4>

                <p class="text-white-50">
                    Try adjusting your filters or selecting another date range.
                </p>

            </div>
        }
        else
        {

            <!-- STATS -->
            <div class="row g-4 mb-5">

                <div class="col-md-4">
                    <div class="stats-card glass highlight">
                        <span>Overall Rate</span>
                        <h1>@ViewBag.AttendanceRate%</h1>
                    </div>
                </div>

                @foreach (var item in ViewBag.ByStatus)
                {
                    var highlight =
                    item.Status.ToString() == "Present"
                    ? "highlight"
                    : "";

                    <div class="col-md-4">
                        <div class="stats-card glass @highlight">
                            <span>@item.Status Days</span>
                            <h1>@item.Count</h1>
                        </div>
                    </div>
                }

            </div>



            <!-- CONTENT -->
            <div class="row g-4">

                <!-- BY COURSE -->
                <div class="col-lg-6">
                    <div class="glass glass-card h-100">

                        <h5 class="mb-4 fw-semibold">
                            <i class="bi bi-journal-text me-2"></i>
                            Attendance by Course
                        </h5>

                        @foreach (var item in ViewBag.ByCourse)
                        {
                            <div class="course-item-modern d-flex justify-content-between align-items-center">

                                <div class="course-left d-flex align-items-center gap-3">
                                    <div class="course-icon">
                                        <i class="bi bi-book"></i>
                                    </div>

                                    <span class="course-name">
                                        @item.Course
                                    </span>
                                </div>

                                <span class="course-count">
                                    @item.Count
                                </span>

                            </div>
                        }

                    </div>
                </div>



                <!-- RECENT -->
                <div class="col-lg-6">
                    <div class="glass glass-card h-100">

                        <h5 class="mb-4 fw-semibold">
                            <i class="bi bi-clock-history me-2"></i>
                            Recent Activity
                        </h5>

                        @foreach (var item in ViewBag.Recent)
                        {
                            var color =
                            item.Status.ToString() == "Present"
                            ? "success"
                            : item.Status.ToString() == "Late"
                            ? "warning"
                            : "danger";

                            <div class="activity-item-modern d-flex justify-content-between align-items-center">

                                <div>
                                    <div>@item.Course</div>

                                    <div class="opacity-75">
                                        <i class="bi bi-calendar-event me-1"></i>
                                        @item.TimeRecorded
                                    </div>
                                </div>

                                <span class="badge rounded-pill bg-@color px-3 py-2">
                                    @item.Status
                                </span>

                            </div>
                        }

                    </div>
                </div>

            </div>

        }

    </div>
</div>
