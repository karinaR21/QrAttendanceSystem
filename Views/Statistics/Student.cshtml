@{
    ViewData["Title"] = "My Attendance";
}

<div class="teacher-stats-page">

    <div class="container" style="max-width:1100px;">

        <!-- HEADER -->
        <div class="text-white mb-5">
            <h1 class="fw-semibold mb-2">My Attendance</h1>

            <span class="email-pill">
                <i class="bi bi-envelope me-2"></i>
                @ViewBag.Email
            </span>
        </div>


        <!-- STATS -->
        <div class="row g-4 mb-5 justify-content-center">

            <!-- RATE -->
            <div class="col-md-4">
                <div class="stats-card highlight-soft">
                    <span>Overall Rate</span>
                    <h1>
                        @ViewBag.AttendanceRate%
                    </h1>


                </div>
            </div>

            @foreach (var item in ViewBag.ByStatus)
            {
                var highlight =
                item.Status.ToString() == "Present"
                ? "highlight"
                : "";

                <div class="col-md-4">
                    <div class="stats-card @highlight">
                        <span>@item.Status Days</span>
                        <h1>@item.Count</h1>
                    </div>
                </div>
            }
        </div>


        <!-- CARDS -->
        <div class="row g-4">

            <!-- COURSE -->
            <div class="col-lg-6">
                <div class="glass-card h-100 p-4">
                    <h5 class="mb-4 fw-semibold">
                        <i class="bi bi-journal-text me-2"></i>
                        Attendance by Course
                    </h5>

                    @foreach (var item in ViewBag.ByCourse)
                    {
                        <div class="course-item-modern d-flex justify-content-between align-items-center">

                            <div class="course-left d-flex align-items-center gap-3">
                                <div class="course-icon">
                                    <i class="bi bi-book"></i>
                                </div>

                                <span class="course-name">
                                    @item.Course
                                </span>
                            </div>

                            <span class="course-count">
                                @item.Count
                            </span>

                        </div>

                    }
                </div>
            </div>


            <!-- RECENT -->
            <div class="col-lg-6">
                <div class="glass-card h-100 p-4">
                    <h5 class="mb-4 fw-semibold">
                        <i class="bi bi-clock-history me-2"></i>
                        Recent Activity
                    </h5>

                    @foreach (var item in ViewBag.Recent)
                    {
                        var color =
                        item.Status.ToString() == "Present"
                        ? "success"
                        : item.Status.ToString() == "Late"
                        ? "warning"
                        : "danger";

                        <div class="activity-item-modern d-flex justify-content-between align-items-center">

                            <div>
                                <div class="activity-course">
                                    @item.Course
                                </div>

                                <div class="activity-time">
                                    <i class="bi bi-calendar-event me-1"></i>
                                    @item.TimeRecorded
                                </div>
                            </div>

                            <div class="d-flex align-items-center gap-3">

                                <span class="badge rounded-pill bg-@color px-3 py-2">
                                    @item.Status
                                </span>

                            </div>

                        </div>

                    }
                </div>
            </div>

        </div>

    </div>
</div>
