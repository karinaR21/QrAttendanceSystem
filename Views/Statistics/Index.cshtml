@{
    ViewData["Title"] = "Statistics";
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="teacher-stats-page">

    <div class="container">

        <!-- HEADER -->
        <div class="text-center text-white mb-5">
            <div class="stats-icon mb-3">
                <i class="bi bi-bar-chart-line"></i>
            </div>

            <h2 class="fw-semibold mb-1">Attendance Statistics</h2>
            <p class="opacity-75 mb-0">
                Overview of sessions and student presence
            </p>
        </div>

        <!-- STAT CARDS -->
        <div class="row g-4 mb-4">

            <div class="col-md-6">
                <div class="stats-card highlight">
                    <span>Total Sessions</span>
                    <h1 class="counter">@ViewBag.TotalSessions</h1>
                </div>
            </div>


            <div class="col-md-6">
                <div class="stats-card highlight">
                    <span>Total Attendances</span>
                    <h1 class="counter">@ViewBag.TotalAttendances</h1>
                </div>
            </div>

        </div>

        <!-- TABLES -->
        <div class="row g-4">

            <div class="col-lg-6">
                <div class="glass-card">
                    <h5 class="mb-3">By Grade</h5>

                    <table class="table table-borderless mb-0">
                        <tbody>
                            @foreach (var item in ViewBag.ByGrade)
                            {
                                <tr>
                                    <td>@item.Grade</td>
                                    <td class="text-end fw-semibold">
                                        @item.Count
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="glass-card">
                    <h5 class="mb-3">By Section</h5>

                    <table class="table table-borderless mb-0">
                        <tbody>
                            @foreach (var item in ViewBag.BySection)
                            {
                                <tr>
                                    <td>@item.Section</td>
                                    <td class="text-end fw-semibold">
                                        @item.Count
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

        <!-- CHART -->
        <div class="glass-card mt-4 text-center">
            <h5 class="mb-3">Attendance Overview</h5>

            <div class="chart-wrap">
                <canvas id="statusChart"></canvas>
            </div>
        </div>

    </div>

</div>

<script>
    const chartData = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(ViewBag.ByStatus)
        );

    const ctx = document.getElementById('statusChart');

    new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: chartData.map(x => x.Status),
            datasets: [{
                data: chartData.map(x => x.Count),
                backgroundColor: [
                    '#22c55e', // Present
                    '#facc15', // Late
                    '#ef4444'  // Absent
                ],
                hoverOffset: 10
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '70%',
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        color: '#ffffff',
                        font: {
                            size: 13
                        }
                    }
                }
            }
        }
    });
</script>
