@{
    ViewData["Title"] = "Parent Home";
}

<div class="container mt-5">

    <!-- HEADER -->
    <div class="mb-5 text-white">
        <span class="badge rounded-pill bg-info bg-opacity-25 px-3 py-2 mb-3">
            Parent Dashboard
        </span>

        <h1 class="fw-bold display-6 mb-2">
            Welcome, Parent 👨‍👩‍👧
        </h1>

        <p class="text-white-50 fs-5">
            Monitor your child’s attendance and progress
        </p>
    </div>

    <!-- ACTION CARDS -->
    <div class="row g-4">

        <!-- CHILD ATTENDANCE -->
        <div class="col-md-6">
            <a asp-controller="Statistics" asp-action="Parent"
               class="text-decoration-none">
                <div class="home-card glass p-4 h-100">
                    <div class="icon-circle bg-primary-gradient">
                        <i class="bi bi-person-check"></i>
                    </div>

                    <h4 class="fw-bold mt-4 text-white">
                        Child Attendance
                    </h4>

                    <p class="text-white-50">
                        View detailed attendance records
                    </p>

                </div>
            </a>
        </div>

        <!-- SUBMIT ABSENCE -->
        <div class="col-md-6">
            <a asp-controller="Absences" asp-action="Create"
               class="text-decoration-none">
                <div class="home-card glass p-4 hover-card h-100">

                    <div class="icon-circle bg-warning-gradient">
                        <i class="bi bi-envelope-paper"></i>
                    </div>

                    <h4 class="fw-bold mt-4 text-white">
                        Submit Absence
                    </h4>

                    <p class="text-white-50">
                        Notify the school and provide a reason for your child's absence.
                    </p>

                </div>
            </a>
        </div>


    </div>
</div>
