@using Microsoft.AspNetCore.Http
@{
    var email = Context.Session.GetString("Email");
}
<div class="bg-visuals">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
</div>

<div class="app-container mt-5 py-4">
    <div class="row mb-5">
        <div class="col-12">
            <span class="badge rounded-pill px-3 py-2 mb-3" style="background: rgba(99, 102, 241, 0.15); color: #818cf8; border: 1px solid rgba(129, 140, 248, 0.2);">
                <i class="bi bi-mortarboard-fill me-2"></i> Student Portal
            </span>

            <h1 class="display-5 fw-bold text-white mb-2">Welcome, Student 🎓</h1>

            @if (!string.IsNullOrEmpty(email))
            {
                <div class="email-pill mb-3">
                    <i class="bi bi-envelope-at-fill"></i>
                    <span>@email</span>
                </div>
            }

            <p class="text-white-50 fs-5">Manage your attendance and track your progress.</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <a asp-controller="Attendance" asp-action="Scan" class="text-decoration-none">
                <div class="glass p-5 hover-card">
                    <div class="icon-circle bg-primary-gradient mb-4">
                        <i class="bi bi-camera-fill"></i>
                    </div>
                    <h3 class="text-white fw-bold">Scan QR Code</h3>
                    <p class="text-white-50 mb-0">Use your camera to check into your current class session instantly.</p>
                    <div class="scan-text">
                        Launch Scanner <i class="bi bi-arrow-right"></i>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-6">
            <a asp-controller="Statistics" asp-action="Student" class="text-decoration-none">
                <div class="glass p-5 hover-card">
                    <div class="icon-circle bg-success-gradient mb-4">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <h3 class="text-white fw-bold">My Attendance</h3>
                    <p class="text-white-50 mb-0">Review your past attendance records and overall percentage.</p>
                    <div class="scan-text success">
                        View History <i class="bi bi-arrow-right"></i>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>