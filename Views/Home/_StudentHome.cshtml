@using Microsoft.AspNetCore.Http
@{
    var email = Context.Session.GetString("Email");
}

<div class="container mt-5">

    <!-- HEADER -->
    <div class="mb-5 text-white">
        <span class="badge rounded-pill bg-primary bg-opacity-25 px-3 py-2 mb-3">
            Student Dashboard
        </span>

        <h1 class="fw-bold display-6 mb-2">
            Welcome, Student 🎓
        </h1>

        @if (!string.IsNullOrEmpty(email))
        {
            <div class="email-badge mt-2">
                <i class="bi bi-envelope me-2"></i>
                @email
            </div>
        }

        <p class="text-white-50 fs-5 mt-3">
            Scan QR codes and track your attendance
        </p>
    </div>

    <!-- ACTION CARDS -->
    <div class="row g-4">
        <div class="col-md-6">
            <a asp-controller="Attendance" asp-action="Scan" class="text-decoration-none">
                <div class="home-card glass p-4 hover-card">
                    <div class="icon-circle bg-primary-gradient">
                        <i class="bi bi-camera"></i>
                    </div>
                    <h4 class="fw-bold mt-4 text-white">Scan QR Code</h4>
                    <p class="text-white-50">Mark your attendance</p>
                </div>
            </a>
        </div>

        <div class="col-md-6">
            <a asp-controller="Statistics" asp-action="Student" class="text-decoration-none">
                <div class="home-card glass p-4 hover-card">
                    <div class="icon-circle bg-success-gradient">
                        <i class="bi bi-bar-chart"></i>
                    </div>
                    <h4 class="fw-bold mt-4 text-white">My Attendance</h4>
                    <p class="text-white-50">View your attendance history</p>
                </div>
            </a>
        </div>
    </div>

</div>
