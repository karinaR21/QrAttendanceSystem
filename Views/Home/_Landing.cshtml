
    @using Microsoft.AspNetCore.Http
    @{
        ViewData["Title"] = "Get Started";
        var role = Context.Session.GetString("Role");
    }

    <div class="landing position-relative">

        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
        <div class="blob blob-3"></div>

        <div class="container">
            <div class="row min-vh-75 align-items-center justify-content-center">

                <div class="col-lg-6 text-white text-center text-lg-start mb-5 mb-lg-0">

                    <span class="badge rounded-pill bg-primary bg-opacity-25 mb-3 px-3 py-2">
                        QR Attendance System
                    </span>

                    <h1 class="display-4 fw-bold mb-3">
                        Smart QR<br />Attendance
                    </h1>

                    <p class="text-white-50 fs-5 mb-4">
                        Automatic attendance with QR codes,
                        real-time validation and smart statistics
                        for schools.
                    </p>

                    @if (string.IsNullOrEmpty(role))
                    {
                        <div class="d-flex gap-3 justify-content-center justify-content-lg-start">
                            <a asp-controller="Auth" asp-action="Index"
                               class="btn btn-primary btn-lg px-5">
                                Get Started
                            </a>

                        </div>
                    }

                </div>

                <div class="col-lg-5 d-flex justify-content-center">

                    <div class="system-core glass p-5">

                        <div class="core-ring"></div>

                        <div class="qr-top">
                            <i class="bi bi-qr-code-scan"></i>
                        </div>

                        <div class="core-center text-center">
                            <h4 class="fw-bold mb-1">QR Attendance</h4>
                            <p class="text-white-50 small mb-0">
                                Scan • Validate • Record
                            </p>
                        </div>

                        <div class="core-icons">
                            <span class="floating-icon icon-2">
                                <i class="bi bi-shield-check"></i>
                            </span>
                            <span class="floating-icon icon-3">
                                <i class="bi bi-bar-chart"></i>
                            </span>
                            <span class="floating-icon icon-4">
                                <i class="bi bi-people"></i>
                            </span>
                        </div>

                    </div>


                </div>

            </div>
        </div>

    </div>


