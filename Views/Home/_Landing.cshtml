@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Get Started";
    var role = Context.Session.GetString("Role");
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">


<div class="landing-hero">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>

    <div class="container">
        <div class="row align-items-center">

            <div class="col-lg-6">
                <span class="badge rounded-pill mb-3 px-3 py-2" style="background: rgba(99, 102, 241, 0.15); color: #818cf8;">
                    QR Attendance System
                </span>
                <h1 class="display-title">Smart QR<br> Attendance</h1>
                <p class="lead-text">
                    Автоматизирайте отчитането на присъствието във вашето училище.
                    Бързо, сигурно и с детайлна статистика.
                </p>
                @if (string.IsNullOrEmpty(role))
                {
                    <a asp-controller="Auth" asp-action="Index" class="btn-get-started">
                        Започнете сега <i class="bi bi-arrow-right"></i>
                    </a>
                }
            </div>

            <div class="col-lg-5 offset-lg-1">
                <div class="system-core">
                    <div class="core-ring"></div>

                    <div class="floating-icon icon-1 shadow"><i class="bi bi-shield-lock"></i></div>
                    <div class="floating-icon icon-2 shadow"><i class="bi bi-bar-chart"></i></div>
                    <div class="floating-icon icon-3 shadow"><i class="bi bi-people"></i></div>

                    <div class="core-center">
                        <div class="qr-top">
                            <i class="bi bi-qr-code-scan"></i>
                        </div>
                        <h4 class="fw-bold">QR Attendance</h4>
                        <p>Scan • Validate • Record</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>