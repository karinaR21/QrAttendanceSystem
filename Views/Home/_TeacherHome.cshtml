@using Microsoft.AspNetCore.Http
@{
    var email = Context.Session.GetString("Email");
}

<div class="container mt-5">

    <!-- HEADER -->
    <div class="mb-5 text-white">

        <span class="badge rounded-pill bg-primary bg-opacity-25 px-3 py-2 mb-3">
            Teacher Dashboard
        </span>

        <h1 class="fw-bold display-6 mb-2">
            Welcome, Teacher 👩‍🏫
        </h1>

        @if (!string.IsNullOrEmpty(email))
        {
            <div class="email-badge mt-2">
                <i class="bi bi-envelope me-2"></i>
                @email
            </div>
        }

        <p class="text-white-50 fs-5 mt-3">
            Manage lessons, generate QR codes and analyze attendance
        </p>
    </div>

    <!-- ACTION CARDS -->
    <div class="row g-4">

        <!-- GENERATE QR -->
        <div class="col-md-6">
            <a asp-controller="Sessions" asp-action="Create"
               class="text-decoration-none">

                <div class="home-card glass p-4 hover-card">

                    <div class="icon-circle bg-primary-gradient">
                        <i class="bi bi-qr-code"></i>
                    </div>

                    <h4 class="fw-bold mt-4 text-white">
                        Generate QR Code
                    </h4>

                    <p class="text-white-50">
                        Start a lesson and generate a live QR code
                        for student attendance.
                    </p>

                </div>
            </a>
        </div>

        <!-- STATISTICS -->
        <div class="col-md-6">
            <a asp-controller="Statistics" asp-action="Index"
               class="text-decoration-none">

                <div class="home-card glass p-4 hover-card">

                    <div class="icon-circle bg-success-gradient">
                        <i class="bi bi-bar-chart"></i>
                    </div>

                    <h4 class="fw-bold mt-4 text-white">
                        Attendance Statistics
                    </h4>

                    <p class="text-white-50">
                        View attendance data, trends and insights
                        across all sessions.
                    </p>

                </div>
            </a>
        </div>

    </div>
</div>
